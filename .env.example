# Copy to .env and fill in secrets (never commit .env)

# DeepSeek API key for LLM tool calling
DEEPSEEK_API_KEY=

# OpenAI-compatible Whisper STT
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1

# MCP health server (stdio); example — adjust path to your health MCP binary:
# MCP_HEALTH_COMMAND=/path/to/health-mcp serve --db /path/to/health.db
MCP_HEALTH_COMMAND=
