# Copy to .env and fill in secrets (never commit .env)

# DeepSeek API key for LLM tool calling
DEEPSEEK_API_KEY=

# OpenAI-compatible Whisper STT
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# Remote health MCP (streamable-HTTP). Token identifies the user (e.g. user1).
# MCP_HEALTH_URL=https://47.94.4.180:8443/mcp
# MCP_HEALTH_TOKEN=
# MCP_HEALTH_TOKEN_FILE=~/.cursor/health-mcp.token
# MCP_HEALTH_CA_FILE=~/.cursor/health-mcp-ca.pem
# NO_PROXY=47.94.4.180

# Local stdio fallback when URL is unset:
# MCP_HEALTH_COMMAND=/path/to/health-mcp serve --db /path/to/health.db
MCP_HEALTH_COMMAND=
